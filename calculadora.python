def suma(a, b):
    return a + b

def resta(a, b):
    return a - b

def multiplicacion(a, b):
    return a * b

def division(a, b):
    return a / b

def pedir_numero(mensaje):
    while True:
        try:
            return float(input(mensaje))
        except ValueError:
            print("Debes escribir un número válido.")

resultado = None
historial = []

while True:
    print("""
Bienvenido a la calculadora. Elige una opción:
1. Suma
2. Resta
3. Multiplicación
4. División
5. Volver atrás (reiniciar el resultado)
6. Salir
""")

    try:
        eleccion = int(input("Opción: "))
    except ValueError:
        print("Debes introducir un número.")
        continue

    if eleccion == 6:
        print("\nSaliendo de la calculadora.")
        if historial:
            print("Historial:")
            for operacion in historial:
                print(operacion)
        break

    if eleccion == 5:
        resultado = None
        print("Resultado reiniciado.")
        continue

    if eleccion not in (1, 2, 3, 4):
        print("Opción no válida.")
        continue

    if resultado is None:
        num1 = pedir_numero("Dime el primer número: ")
    else:
        num1 = resultado
        print(f"Usaremos el resultado anterior: {num1}")

    num2 = pedir_numero("Dime el segundo número: ")

    if eleccion == 1:
        simbolo = "+"
        nuevo_resultado = suma(num1, num2)
    elif eleccion == 2:
        simbolo = "-"
        nuevo_resultado = resta(num1, num2)
    elif eleccion == 3:
        simbolo = "*"
        nuevo_resultado = multiplicacion(num1, num2)
    else:
        simbolo = "/"
        if num2 == 0:
            print("No se puede dividir entre cero.")
            continue
        nuevo_resultado = division(num1, num2)

    resultado = nuevo_resultado
    registro = f"{num1} {simbolo} {num2} = {resultado}"
    historial.append(registro)
    print(registro)
